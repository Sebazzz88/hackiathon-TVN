# Sin secretos reales aquí. Copiar a .env (que está en .gitignore)
AGENT_MODE=live          # live = agente IA (backend/app/agent) | stub = datos DEMO sintéticos
DATA_DIR=                # vacío = carpeta data/ del repo
TVN_RSS_URL=             # vacío = https://www.tvn-2.com/rss/ (referencia [2] del PDF del reto)
NEWS_DAYS=30             # ventana de noticias GDELT (días)

# IA generativa para borradores y respuestas. Por defecto: Hermes 3 local y GRATUITO vía Ollama (sin clave ni internet).
#   Instalar: winget install Ollama.Ollama   y luego   ollama pull hermes3:3b
LLM_PROVIDER=ollama      # ollama (local, gratis) | openai (API compatible: Kimi, Groq...) | anthropic (Claude)
LLM_MODEL=hermes3:3b     # en ollama: hermes3:3b, qwen2.5:3b, llama3.2:3b...
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT=600          # segundos; en CPU un borrador puede tardar 1-2 min
LLM_OFFLINE=0            # 1 = no llamar a ningún modelo (usa solo caché/plantilla)
# Solo para proveedores en la nube (no hace falta con Ollama):
LLM_API_KEY=             # NUNCA la subas al repo ni la pegues en prompts/logs
LLM_BASE_URL=            # p. ej. https://api.moonshot.ai/v1 (Kimi) si LLM_PROVIDER=openai
