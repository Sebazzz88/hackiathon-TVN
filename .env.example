# Sin secretos reales aquí. Copiar a .env (que está en .gitignore)
AGENT_MODE=live          # live = agente IA (backend/app/agent) | stub = datos DEMO sintéticos
DATA_DIR=                # vacío = carpeta data/ del repo
TVN_RSS_URL=             # vacío = https://www.tvn-2.com/rss/ (referencia [2] del PDF del reto)
NEWS_DAYS=30             # ventana de noticias GDELT (días)

# LLM para borradores (opcional). Sin clave o sin internet se usa la caché y luego la plantilla determinista.
LLM_API_KEY=             # clave de Anthropic; NUNCA la subas al repo ni la pegues en prompts/logs
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low           # low | medium | high (más alto = más lento y caro)
LLM_OFFLINE=0            # 1 = no llamar al LLM aunque haya clave (demo sin internet, T10)
